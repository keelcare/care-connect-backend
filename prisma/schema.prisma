generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model applications {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  job_id     String?   @db.Uuid
  nanny_id   String?   @db.Uuid
  status     String?   @default("applied") @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  jobs       jobs?     @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users?    @relation(fields: [nanny_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([job_id, nanny_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bookings {
  id                              String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  job_id                          String?                     @db.Uuid
  parent_id                       String?                     @db.Uuid
  nanny_id                        String?                     @db.Uuid
  status                          String?                     @default("requested") @db.VarChar(50)
  start_time                      DateTime?                   @db.Timestamptz(6)
  end_time                        DateTime?                   @db.Timestamptz(6)
  created_at                      DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime?                   @default(now()) @db.Timestamptz(6)
  request_id                      String?                     @unique @db.Uuid
  cancellation_fee                Decimal?                    @db.Decimal(10, 2)
  cancellation_fee_status         String?                     @db.VarChar(50)
  cancellation_reason             String?
  care_location_lat               Decimal?                    @db.Decimal(10, 8)
  care_location_lng               Decimal?                    @db.Decimal(11, 8)
  geofence_radius                 Int?                        @default(100)
  is_review_prompted              Boolean?                    @default(false)
  recurring_booking_id            String?                     @db.Uuid
  actual_end_time                 DateTime?                   @db.Timestamptz(6)
  actual_start_time               DateTime?                   @db.Timestamptz(6)
  last_rescheduled_at             DateTime?                   @db.Timestamptz(6)
  original_end_time               DateTime?                   @db.Timestamptz(6)
  original_start_time             DateTime?                   @db.Timestamptz(6)
  reschedule_count                Int?                        @default(0)
  tags                            String[]                    @default([])
  recurring_request_id            String?                     @db.Uuid
  /// Pricing layer 1: how the final price is computed
  pricing_mode                    String                      @default("standard") @db.VarChar(50)
  /// Used when pricing_mode = 'custom_rate'
  custom_hourly_rate              Decimal?                    @db.Decimal(10, 2)
  /// Used when pricing_mode = 'custom_override' (treated as the pre-tax subtotal)
  custom_final_price              Decimal?                    @db.Decimal(12, 2)
  /// Pricing layer 2: whether rate is pinned to booking creation date or floats
  price_lock_mode                 String                      @default("locked") @db.VarChar(50)
  /// Session schedule: hours per day (e.g. 4)
  hours_per_day                   Decimal?                    @db.Decimal(4, 2)
  /// Session schedule: days per week (e.g. 5)
  days_per_week                   Int?
  /// Total number of recurring months (e.g. 6)
  plan_duration_months            Int                         @default(1)
  /// Allocated from `invoice_number_seq` the first time a parent downloads this
  /// booking's invoice, then never changed. The booking — not the instalment —
  /// is the invoice unit: a family gets one document covering the matching fee
  /// and every instalment of the engagement.
  invoice_number                  String?                     @unique @db.VarChar(32)
  invoice_issued_at               DateTime?                   @db.Timestamptz(6)
  booking_children                booking_children[]
  call_sessions                   call_sessions[]
  jobs                            jobs?                       @relation(fields: [job_id], references: [id], onUpdate: NoAction)
  users_bookings_nanny_idTousers  users?                      @relation("bookings_nanny_idTousers", fields: [nanny_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_bookings_parent_idTousers users?                      @relation("bookings_parent_idTousers", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recurring_bookings              recurring_bookings?         @relation(fields: [recurring_booking_id], references: [id], onUpdate: NoAction)
  recurring_service_requests      recurring_service_requests? @relation(fields: [recurring_request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service_requests                service_requests?           @relation(fields: [request_id], references: [id], onUpdate: NoAction)
  assignments                     assignments[]
  chats                           chats[]
  disputes                        disputes[]
  location_updates                location_updates[]
  payments                        payments[]
  progress_reports                progress_reports?
  reviews                         reviews[]
  payment_plans                   payment_plans?
  price_snapshots                 price_snapshots[]
  payment_installments            payment_installments[]
  support_tickets                 support_tickets[]
  booking_status_logs             booking_status_log[]
  attendance_events               nanny_attendance_events[]
  invoices                        invoices[]
  credit_notes                    credit_notes[]

  @@index([parent_id, status])
  @@index([nanny_id, status])
  @@index([start_time, status])
}

/// One row per booking status transition — the per-booking history that
/// payments already get via payment_audit_log. One-off bookings previously kept
/// only the latest `updated_at`, so prior states were lost. Append-only.
model booking_status_log {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  booking_id  String   @db.Uuid
  from_status String?  @db.VarChar(50)
  to_status   String   @db.VarChar(50)
  /// The user who caused the transition, when known. Null for system/cron.
  changed_by  String?  @db.Uuid
  /// 'parent' | 'nanny' | 'admin' | 'system'
  actor_role  String?  @db.VarChar(20)
  reason      String?
  metadata    Json?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  bookings    bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([booking_id])
  @@index([created_at])
}

/// Append-only attendance facts for caregivers. One row per attendance-relevant
/// thing that happened, almost always tied to the booking it happened on.
///
/// The unit of attendance is the *committed session*, not the calendar day: a
/// caregiver here is rostered onto a plan at a fixed address, so "was she online"
/// says nothing about whether a child was cared for. What is verifiable is the
/// geofenced check-in already enforced by `startBooking`, the check-out, and the
/// GPS trail between them — this table is the durable record of those.
///
/// `score_weight` is frozen at write time rather than looked up from policy at
/// read time, for the same reason `price_snapshots` freezes its GST rate:
/// retuning the attendance policy must never retroactively rewrite the record a
/// caregiver was already judged on.
model nanny_attendance_events {
  id               String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nanny_id         String                @db.Uuid
  booking_id       String?               @db.Uuid
  type             attendance_event_type
  /// IST calendar day this is attributed to — the day the *slot* belonged to, not
  /// the day the row was written. A 23:00 session flagged at 00:20 by the sweeper
  /// still belongs to the previous day.
  attendance_date  DateTime              @db.Date
  /// Slot start copied at write time, so a later reschedule cannot silently turn a
  /// late arrival into an on-time one.
  scheduled_start  DateTime?             @db.Timestamptz(6)
  occurred_at      DateTime              @default(now()) @db.Timestamptz(6)
  /// Minutes late (positive) or early (negative) against the scheduled boundary.
  minutes_delta    Int?
  /// Distance from the care location when the event fired — geofence events only.
  distance_meters  Int?
  /// Contribution to the rolling score, frozen at write time.
  score_weight     Decimal               @default(0) @db.Decimal(4, 2)
  /// True for the one terminal event that settles a session (attended / no-show /
  /// cancelled). Only these form the score's denominator; modifiers such as a
  /// geofence breach subtract from the numerator without inflating exposure.
  is_session_outcome Boolean             @default(false)
  /// 'app' | 'system' | 'admin' — who or what observed it.
  source           String                @default("system") @db.VarChar(20)
  notes            String?
  /// Idempotency key for the once-per-booking events (`<booking_id>:<type>`), null
  /// for the repeatable ones. Postgres does not collide NULLs in a unique index,
  /// so one column covers both without a partial index Prisma cannot express.
  dedupe_key       String?               @unique @db.VarChar(120)
  /// Set when an admin excuses the event — a family that cancelled at the door, a
  /// medical emergency, an app failure. Waived events stay visible in the
  /// caregiver's timeline but drop out of scoring entirely.
  waived_at        DateTime?             @db.Timestamptz(6)
  waived_by        String?               @db.Uuid
  waiver_reason    String?
  metadata         Json?
  created_at       DateTime              @default(now()) @db.Timestamptz(6)
  users            users                 @relation("attendance_events_nanny", fields: [nanny_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bookings         bookings?             @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  waived_by_user   users?                @relation("attendance_events_waived_by", fields: [waived_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([nanny_id, attendance_date])
  @@index([nanny_id, occurred_at])
  @@index([booking_id])
}

/// One roll-up row per caregiver per IST calendar day, derived from the events
/// above by the nightly job. Kept as a table rather than computed on read because
/// the attendance calendar in the partner app and the admin roster view are both
/// range scans over months of history, and because an admin override needs
/// somewhere to live that a replay of the event log will not overwrite.
model nanny_attendance_days {
  id                          String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nanny_id                    String                 @db.Uuid
  attendance_date             DateTime               @db.Date
  status                      attendance_day_status
  sessions_scheduled          Int                    @default(0)
  sessions_attended           Int                    @default(0)
  sessions_late               Int                    @default(0)
  sessions_missed             Int                    @default(0)
  sessions_cancelled_by_nanny Int                    @default(0)
  minutes_late                Int                    @default(0)
  minutes_worked              Int                    @default(0)
  /// Set by an admin to correct the derived status — approved leave logged after
  /// the fact, a session the office cancelled by phone. Read in preference to
  /// `status` everywhere, and never touched by the nightly recompute.
  override_status             attendance_day_status?
  override_reason             String?
  overridden_by               String?                @db.Uuid
  overridden_at               DateTime?              @db.Timestamptz(6)
  computed_at                 DateTime               @default(now()) @db.Timestamptz(6)
  users                       users                  @relation("attendance_days_nanny", fields: [nanny_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  overridden_by_user          users?                 @relation("attendance_days_overridden_by", fields: [overridden_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([nanny_id, attendance_date])
  @@index([attendance_date, status])
}

model chats {
  id         String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  booking_id String?    @db.Uuid
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  bookings   bookings?  @relation(fields: [booking_id], references: [id], onUpdate: NoAction)
  messages   messages[]
}

/// One row per WebRTC call attempt between the booking's parent and nanny.
model call_sessions {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  booking_id String    @db.Uuid
  caller_id  String    @db.Uuid
  callee_id  String    @db.Uuid
  /// RINGING | ONGOING | ENDED | MISSED | REJECTED | CANCELLED | FAILED
  status     String    @default("RINGING") @db.VarChar(20)
  /// Set when the callee answers
  started_at DateTime? @db.Timestamptz(6)
  ended_at   DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  bookings   bookings  @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([booking_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model jobs {
  id           String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  parent_id    String?        @db.Uuid
  title        String         @db.VarChar(255)
  description  String?
  date         DateTime       @db.Date
  time         DateTime       @db.Time(6)
  location_lat Decimal?       @db.Decimal(10, 8)
  location_lng Decimal?       @db.Decimal(11, 8)
  status       String?        @default("open") @db.VarChar(50)
  created_at   DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?      @default(now()) @db.Timestamptz(6)
  applications applications[]
  bookings     bookings[]
  users        users?         @relation(fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model messages {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  chat_id        String?   @db.Uuid
  sender_id      String?   @db.Uuid
  content        String
  read_status    Boolean?  @default(false)
  attachment_url String?
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  chats          chats?    @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users?    @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model nanny_details {
  user_id               String    @id @db.Uuid
  skills                String[]
  experience_years      Int?
  bio                   String?
  availability_schedule Json?
  created_at            DateTime? @default(now()) @db.Timestamptz(6)
  updated_at            DateTime? @default(now()) @db.Timestamptz(6)
  acceptance_rate       Decimal?  @default(0) @db.Decimal(5, 2)
  is_available_now      Boolean?  @default(true)
  categories            String[]  @default([])
  tags                  String[]  @default([])
  auto_accept_bookings  Boolean   @default(true)
  default_start_time    String?   @db.VarChar(5)
  default_end_time      String?   @db.VarChar(5)
  /// Rolling attendance score, 0–100, recomputed nightly from
  /// `nanny_attendance_events`. Denormalised onto the profile so matching and
  /// admin ranking can read one number without replaying the event log — the
  /// same trade-off `acceptance_rate` already makes. Null until the caregiver
  /// has enough sessions in the window for the number to mean anything.
  attendance_score      Decimal?  @db.Decimal(5, 2)
  /// Session outcomes the score above was computed from. Exposed so a low score
  /// off three sessions is never presented with the same confidence as one off
  /// sixty.
  attendance_sessions   Int       @default(0)
  attendance_updated_at DateTime? @db.Timestamptz(6)
  /// Last heartbeat from the partner app. Presence is only ever an attendance
  /// signal *during* a committed session — a caregiver with nothing rostered is
  /// off duty, not absent.
  last_seen_at          DateTime? @db.Timestamptz(6)
  users                 users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model nanny_onboarding_details {
  user_id                       String    @id @db.Uuid
  age                           Int?
  gender                        String?   @db.VarChar(30)
  permanent_address             String?
  city                          String?   @db.VarChar(100)
  education_qualification       String?   @db.VarChar(50)
  education_qualification_other String?   @db.VarChar(255)
  stream_subjects               String?
  shadow_teacher_experience     String?   @db.VarChar(20)
  /// Service categories the nanny applies for (services.name — CC/ST/SN).
  /// Copied onto nanny_details.categories when onboarding is completed.
  categories                    String[]  @default([])
  age_groups_worked             String[]  @default([])
  children_types_supported      String[]  @default([])
  children_types_other          String?   @db.VarChar(255)
  academic_subjects             String[]  @default([])
  hobbies_interests             String?
  hobbies_activities_for_child  String[]  @default([])
  previous_salary               String?
  available_start_date          DateTime? @db.Date
  training_agreement            Boolean?
  placement_fee_agreement       Boolean?
  police_verification_consent   Boolean?
  declaration_confirmed         Boolean?  @default(false)
  declaration_confirmed_at      DateTime? @db.Timestamptz(6)
  onboarding_completed_at       DateTime? @db.Timestamptz(6)
  created_at                    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime? @default(now()) @db.Timestamptz(6)
  users                         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model nanny_category_requests {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nanny_id             String    @db.Uuid
  requested_categories String[]
  status               String    @default("pending") @db.VarChar(50)
  admin_notes          String?
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)
  users                users     @relation(fields: [nanny_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// Service requests created by parents for childcare services
model service_requests {
  id                    String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  parent_id             String              @db.Uuid
  date                  DateTime            @db.Date
  start_time            DateTime            @db.Time(6)
  duration_hours        Decimal             @db.Decimal(4, 2)
  num_children          Int
  children_ages         Json?
  special_requirements  String?
  location_lat          Decimal             @db.Decimal(10, 8)
  location_lng          Decimal             @db.Decimal(11, 8)
  status                String              @default("pending") @db.VarChar(50)
  current_assignment_id String?             @db.Uuid
  created_at            DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?           @default(now()) @db.Timestamptz(6)
  required_skills       String[]
  category              String?             @db.VarChar(50)
  plan_duration_months  Int?                @default(1)
  plan_type             String?             @db.VarChar(50)
  sessions_per_month    Int?
  /// Days a week the schedule runs. The pricing factor `sessions_per_month` could
  /// only ever approximate; recurring plans are priced off this.
  days_per_week         Int?
  max_hourly_rate       Decimal?            @db.Decimal(10, 2)
  assignments           assignments[]
  bookings              bookings?
  matching_feedback     matching_feedback[]
  users                 users               @relation(fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// Assignments of service requests to nannies
model assignments {
  id                String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  request_id        String?           @db.Uuid
  booking_id        String?           @db.Uuid
  nanny_id          String            @db.Uuid
  assigned_at       DateTime          @default(now()) @db.Timestamptz(6)
  response_deadline DateTime          @db.Timestamptz(6)
  status            String            @default("pending") @db.VarChar(50)
  rejection_reason  String?
  responded_at      DateTime?         @db.Timestamptz(6)
  rank_position     Int
  created_at        DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?         @default(now()) @db.Timestamptz(6)
  users             users             @relation(fields: [nanny_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service_requests  service_requests? @relation(fields: [request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bookings          bookings?         @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([request_id, nanny_id])
  @@unique([booking_id, nanny_id])
  @@index([request_id, status])
  @@index([booking_id, status])
}

model payments {
  id                   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  booking_id           String                 @db.Uuid
  nanny_id             String?                @db.Uuid
  amount               Decimal                @db.Decimal(12, 2)
  status               String                 @db.VarChar(50)
  transaction_id       String?                @unique @db.VarChar(255)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  currency             String                 @default("inr") @db.VarChar(10)
  error_code           String?
  error_description    String?
  order_id             String                 @unique @db.VarChar(255)
  payment_id           String?                @unique @db.VarChar(255)
  provider             String                 @default("razorpay")
  refund_id            String?
  signature            String?
  updated_at           DateTime?              @default(now()) @db.Timestamptz(6)
  /// Set when an admin releases the caregiver's share of this payment. A
  /// `pending_release` row with a null `released_at` is an outstanding payout.
  released_at          DateTime?              @db.Timestamptz(6)
  released_by          String?                @db.Uuid
  payment_audit_log    payment_audit_log[]
  price_snapshots      price_snapshots[]
  payment_installments payment_installments[]
  bookings             bookings               @relation(fields: [booking_id], references: [id])
  nanny                users?                 @relation("payments_nanny_idTousers", fields: [nanny_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  released_by_user     users?                 @relation("payments_released_by", fields: [released_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([status, released_at])
}

model payment_audit_log {
  id                  String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  payment_id          String   @db.Uuid
  order_id            String   @db.VarChar(255)
  from_status         String?  @db.VarChar(50)
  to_status           String   @db.VarChar(50)
  triggered_by        String   @db.VarChar(100)
  razorpay_payment_id String?  @db.VarChar(255)
  metadata            Json?
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  payments            payments @relation(fields: [payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id])
  @@index([payment_id])
}

model profiles {
  user_id              String    @id @db.Uuid
  first_name           String?   @db.VarChar(100)
  last_name            String?   @db.VarChar(100)
  phone                String?   @db.VarChar(20)
  address              String?
  location_address     String?
  lat                  Decimal?  @db.Decimal(10, 8)
  lng                  Decimal?  @db.Decimal(11, 8)
  profile_image_url    String?
  onboarding_completed Boolean?  @default(false)
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)
  users                users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// Saved addresses for a user (multiple allowed; exactly one is_default per user).
model addresses {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String    @db.Uuid
  label      String    @default("Home") @db.VarChar(50)
  address    String
  lat        Decimal   @db.Decimal(10, 8)
  lng        Decimal   @db.Decimal(11, 8)
  is_default Boolean   @default(false)
  /// Soft delete: rows are never hard-deleted, so completed bookings keep
  /// their address history and removals leave an audit trail.
  deleted_at DateTime? @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  id                               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  booking_id                       String?   @db.Uuid
  reviewer_id                      String?   @db.Uuid
  reviewee_id                      String?   @db.Uuid
  reviewer_role                    String?   @db.VarChar(50)
  rating                           Int?
  comment                          String?
