/// Billing plan for recurring bookings — thin wrapper tracking cycle count and next due date
model payment_plans {
  id                   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  booking_id           String                 @unique @db.Uuid
  total_cycles         Int
  cycles_completed     Int                    @default(0)
  start_date           DateTime               @db.Timestamptz(6)
  next_due_date        DateTime               @db.Timestamptz(6)
  status               String                 @default("active") @db.VarChar(50)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  bookings             bookings               @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  price_snapshots      price_snapshots[]
  payment_installments payment_installments[]

  @@index([status, next_due_date])
}

/// Immutable billing history — one row per charged/attempted cycle. Never updated, only inserted.
model price_snapshots {
  id                    String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  booking_id            String                 @db.Uuid
  payment_plan_id       String?                @db.Uuid
  payment_id            String?                @db.Uuid
  cycle_number          Int
  base_hourly_rate_used Decimal                @db.Decimal(10, 2)
  /// Retained for historical accuracy only — the discount system was removed and
  /// this is always 0 on new rows. Rows charged before the removal keep their rate.
  discount_percent_used Decimal                @default(0) @db.Decimal(5, 2)
  hours_billed          Decimal                @db.Decimal(8, 2)
  custom_price_applied  Boolean                @default(false)
  /// Pre-tax amount. GST rate frozen at charge time so a later flag flip never
  /// rewrites what a customer was actually charged.
  subtotal_amount       Decimal                @default(0) @db.Decimal(12, 2)
  gst_percent_used      Decimal                @default(0) @db.Decimal(5, 2)
  gst_amount            Decimal                @default(0) @db.Decimal(12, 2)
  /// subtotal_amount + gst_amount — the amount sent to Razorpay.
  final_amount          Decimal                @db.Decimal(12, 2)
  calculation_breakdown Json
  razorpay_payment_id   String?                @db.VarChar(255)
  status                String                 @default("pending") @db.VarChar(50)
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  bookings              bookings               @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payment_plans         payment_plans?         @relation(fields: [payment_plan_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  payments              payments?              @relation(fields: [payment_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  payment_installments  payment_installments[]

  @@index([booking_id])
  @@index([payment_plan_id])
  @@index([status])
}

/// One row per amount actually sent to the gateway. A cycle is normally split into
/// an advance half charged at checkout and a balance half due `advance_payment_due_days`
/// later; a non-splittable cycle gets a single 1-of-1 row, so every snapshot has at
/// least one installment and no read path needs a special case.
///
/// `subtotal_amount` / `gst_amount` are frozen here rather than derived from the
/// snapshot by ratio at read time: payout and revenue maths strip GST per payment,
/// and re-deriving it would let a later rounding or rate change re-state a settled
/// caregiver payout.
model payment_installments {
  id                 String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  booking_id         String          @db.Uuid
  price_snapshot_id  String          @db.Uuid
  payment_plan_id    String?         @db.Uuid
  cycle_number       Int
  /// 1-based position within the cycle. 1 is the advance, 2 the balance — unless a
  /// matching fee was carved out, which takes position 1 and shifts the rest.
  installment_no     Int
  total_installments Int             @default(1)
  /// `cycle` — a share of the cycle's own price.
  /// `matching_fee` — the one-off placement fee, carved *out of* the first cycle's
  /// total rather than added to it, so the parent's all-in cost is unchanged and
  /// the fee is simply the first thing they pay.
  kind               String          @default("cycle") @db.VarChar(20)
  amount             Decimal         @db.Decimal(12, 2)
  subtotal_amount    Decimal         @default(0) @db.Decimal(12, 2)
  gst_amount         Decimal         @default(0) @db.Decimal(12, 2)
  /// Null until the preceding installment is captured — the balance is due a fixed
  /// number of days from when the advance was actually paid, not from checkout.
  due_date           DateTime?       @db.Timestamptz(6)
  /// pending | paid | void | refunded
  status             String          @default("pending") @db.VarChar(20)
  /// Set when the order is created, not at capture: it is the idempotency key that
  /// keeps each half's abandoned checkout distinct from the other's.
  payment_id         String?         @db.Uuid
  paid_at            DateTime?       @db.Timestamptz(6)
  /// Dunning state. An overdue balance stays overdue indefinitely (we never suspend
  /// care over it), so reminders must be paced off this or they repeat daily forever.
  last_reminded_at   DateTime?       @db.Timestamptz(6)
  reminder_count     Int             @default(0)
  /// Allocated from `invoice_number_seq` the first time a parent downloads this
  /// installment's invoice, then never changed — the number on a PDF a family
  /// already holds has to keep meaning the same thing.
  invoice_number     String?         @unique @db.VarChar(32)
  invoice_issued_at  DateTime?       @db.Timestamptz(6)
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime        @default(now()) @db.Timestamptz(6)
  bookings           bookings        @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  price_snapshots    price_snapshots @relation(fields: [price_snapshot_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payment_plans      payment_plans?  @relation(fields: [payment_plan_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  payments           payments?       @relation(fields: [payment_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  invoices           invoices?

  @@unique([price_snapshot_id, installment_no])
  @@index([booking_id])
  @@index([status, due_date])
  @@index([payment_id])
  @@index([kind, booking_id])
}

/// A tax invoice that has been issued to a family. Immutable once written.
///
/// Issued at *capture*, never before: the document only ever describes money the
/// platform has actually taken. That single rule is what makes it safe to freeze.
/// The old model rendered a booking's invoice live from whatever installments
/// existed at read time, so a six-month plan's invoice grew every month under the
/// same number and shrank again when cancellation voided a row — a family could
/// hold two different documents both claiming to be `KL-2026-0001`. It also means
/// a cancellation can never invalidate an issued invoice, so credit notes are
/// reserved for refunds and corrections rather than being part of routine billing.
///
/// `snapshot` is the whole rendered `InvoiceData`. The PDF is built from it, not
/// from the live tables, so a later rate change, a GST-registration flip or a
/// corrected profile name cannot re-state a document already in someone's inbox.
model invoices {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  number            String    @unique @db.VarChar(32)
  /// `tax_invoice` — issued at capture by this system.
  /// `legacy` — backfilled from a number that was minted under the old
  /// render-on-download scheme, so links already in the wild keep resolving.
  kind              String    @default("tax_invoice") @db.VarChar(24)
  booking_id        String    @db.Uuid
  /// The plan this belongs to, when the booking is one session of a recurring
  /// plan. Denormalised off the booking so a plan's documents are one indexed
  /// read rather than a join through every session.
  plan_id           String?   @db.Uuid
  parent_id         String?   @db.Uuid
  /// The capture this documents. Unique, and the whole idempotency story: a
  /// Razorpay webhook replaying after `api:verify_payment` already ran cannot
  /// mint a second number for the same money.
  installment_id    String?   @unique @db.Uuid
  price_snapshot_id String?   @db.Uuid
  cycle_number      Int?
  period_from       DateTime? @db.Timestamptz(6)
  period_to         DateTime? @db.Timestamptz(6)
  subtotal_amount   Decimal   @default(0) @db.Decimal(12, 2)
  gst_amount        Decimal   @default(0) @db.Decimal(12, 2)
  total_amount      Decimal   @default(0) @db.Decimal(12, 2)
  /// Running sum of credit notes raised against this invoice. Maintained here so
  /// "what is this invoice actually worth now" never requires aggregating notes.
  credited_amount   Decimal   @default(0) @db.Decimal(12, 2)
  /// Whether GST registration was in force when this was issued. Frozen for the
  /// same reason the amounts are: enabling registration later must not turn an
  /// already-issued document into a tax invoice retrospectively.
  gst_registered    Boolean   @default(false)
  issued_at         DateTime  @default(now()) @db.Timestamptz(6)
  snapshot          Json

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  bookings                   bookings                    @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recurring_service_requests recurring_service_requests? @relation(fields: [plan_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  payment_installments       payment_installments?       @relation(fields: [installment_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  invoice_lines              invoice_lines[]
  credit_notes               credit_notes[]

  @@index([parent_id, issued_at])
  @@index([booking_id])
  @@index([plan_id])
}

/// One row of an invoice's items table. Duplicated from `snapshot` on purpose:
/// the snapshot is display strings for rendering, these are queryable numbers for
/// revenue reporting and GST returns.
model invoice_lines {
  id              String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  invoice_id      String  @db.Uuid
  seq             Int
  name            String
  description     String?
  qty             Decimal @default(1) @db.Decimal(10, 2)
  unit_amount     Decimal @default(0) @db.Decimal(12, 2)
  subtotal_amount Decimal @default(0) @db.Decimal(12, 2)
  gst_percent     Decimal @default(0) @db.Decimal(5, 2)
  gst_amount      Decimal @default(0) @db.Decimal(12, 2)
  amount          Decimal @default(0) @db.Decimal(12, 2)
  /// How many scheduled sessions this line's money actually bought. The number
  /// the whole plan-invoicing design exists to state — a 50% advance on a
  /// twenty-session month buys ten, and the parent should be able to read that
  /// off the document rather than infer it.
  sessions_covered Int?
  /// Service Accounting Code, populated only once GST registration is enabled.
  sac_code        String? @db.VarChar(12)

  invoices invoices @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([invoice_id])
}

/// A reduction of an already-issued invoice — a GST section 34 credit note.
///
/// Rare by design. Because invoices are only ever issued against captured money,
/// and cancellation converts captured money into retained sessions rather than
/// refunding it, the only things that reach here are discretionary admin refunds,
/// write-offs and billing corrections.
model credit_notes {
  id         String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  number     String @unique @db.VarChar(32)
  invoice_id String @db.Uuid
  booking_id String @db.Uuid
  parent_id  String? @db.Uuid
  /// `refund` | `plan_cancelled` | `written_off` | `correction`
  reason     String @db.VarChar(32)
  /// How the credit was actually settled — money returned, or the value kept as
  /// retained sessions. A note whose settlement is `retained_as_entitlement`
  /// reduces the invoice without any cash moving.
  settlement String @default("refunded") @db.VarChar(32)
  note       String?

  subtotal_amount Decimal @default(0) @db.Decimal(12, 2)
  gst_amount      Decimal @default(0) @db.Decimal(12, 2)
  total_amount    Decimal @default(0) @db.Decimal(12, 2)
  /// The gateway refund, when one was made.
  refund_id       String? @db.VarChar(255)

  issued_at DateTime @default(now()) @db.Timestamptz(6)
  snapshot  Json

  created_at DateTime @default(now()) @db.Timestamptz(6)

  invoices          invoices            @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bookings          bookings            @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  credit_note_lines credit_note_lines[]

  @@index([invoice_id])
  @@index([parent_id, issued_at])
}

model credit_note_lines {
  id              String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  credit_note_id  String  @db.Uuid
  seq             Int
  name            String
  description     String?
  subtotal_amount Decimal @default(0) @db.Decimal(12, 2)
  gst_percent     Decimal @default(0) @db.Decimal(5, 2)
  gst_amount      Decimal @default(0) @db.Decimal(12, 2)
  amount          Decimal @default(0) @db.Decimal(12, 2)

  credit_notes credit_notes @relation(fields: [credit_note_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([credit_note_id])
}

/// The frozen record of what a cancelled plan settled at.
///
/// Not a tax document — no money changes hands at cancellation under the
/// entitlement model — but it is the authoritative answer to the question a
/// cancelling parent actually asks: which sessions do I keep, on what dates, and
/// what happens to the rest. `entitlement` stores the per-cycle working verbatim
/// so a support agent can audit any number on the statement without recomputing
/// it against ledger rows that have since moved.
model plan_settlements {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  number       String   @unique @db.VarChar(32)
  plan_id      String   @unique @db.Uuid
  parent_id    String?  @db.Uuid
  cancelled_at DateTime @db.Timestamptz(6)
  reason       String?

  /// `EntitlementCycle[]` — paid fraction, sessions in cycle, sessions earned.
  entitlement        Json
  sessions_entitled  Int  @default(0)
  sessions_delivered Int  @default(0)
  sessions_retained  Int  @default(0)
  /// The sessions the parent keeps, in date order. Frozen because the bookings
  /// themselves can later be rescheduled or completed, and the statement has to
  /// keep saying what it said on the day.
  retained_booking_ids String[] @db.Uuid

  amount_billed         Decimal @default(0) @db.Decimal(12, 2)
  amount_paid           Decimal @default(0) @db.Decimal(12, 2)
  amount_voided         Decimal @default(0) @db.Decimal(12, 2)
  amount_still_owed     Decimal @default(0) @db.Decimal(12, 2)
  matching_fee_retained Decimal @default(0) @db.Decimal(12, 2)

  snapshot   Json
  created_at DateTime @default(now()) @db.Timestamptz(6)

  recurring_service_requests recurring_service_requests @relation(fields: [plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([parent_id, cancelled_at])
}

/// Gapless-ish counters for each document series.
///
/// Replaces the single global `invoice_number_seq`. GST requires a serial that is
/// unique and consecutive *within a financial year*, and credit notes need their
/// own series rather than sharing the invoice one. A table row incremented inside
/// the issuing transaction also means a rolled-back issue does not burn a number,
/// which a Postgres sequence cannot promise.
model document_series {
  /// `invoice` | `credit_note` | `settlement`
  kind           String   @db.VarChar(24)
  /// Financial-year start year once GST registration is on (Apr–Mar); the plain
  /// calendar year before that, which is what existing numbers already read as.
  financial_year Int
  next_value     Int      @default(1)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  @@id([kind, financial_year])
}

model progress_reports {
  id               String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  booking_id       String           @unique @db.Uuid
  nanny_id         String           @db.Uuid
  child_id         String?          @db.Uuid
  template_id      String           @db.Uuid
  status           report_status    @default(PENDING)
  personal_remark  String?
  due_at           DateTime         @db.Timestamptz(6)
  submitted_at     DateTime?        @db.Timestamptz(6)
  escalated        Boolean          @default(false)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @default(now()) @db.Timestamptz(6)
  bookings         bookings         @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  report_templates report_templates @relation(fields: [template_id], references: [id])
  report_answers   report_answers[]

  @@index([booking_id])
  @@index([nanny_id])
}

model report_answers {
  id               String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  report_id        String           @db.Uuid
  question_id      String           @db.Uuid
  answer_text      String?
  answer_rating    Int?
  answer_choices   String[]         @default([])
  progress_reports progress_reports @relation(fields: [report_id], references: [id], onDelete: Cascade)

  @@index([report_id])
}

model report_template_questions {
  id               String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  template_id      String            @db.Uuid
  question_text    String
  input_type       report_input_type
  options          String[]          @default([])
  is_required      Boolean           @default(true)
  display_order    Int
  report_templates report_templates  @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@index([template_id])
}

model report_templates {
  id                        String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  version                   Int                         @unique @default(autoincrement())
  is_active                 Boolean                     @default(true)
  created_by                String?                     @db.Uuid
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  progress_reports          progress_reports[]
  report_template_questions report_template_questions[]
}

enum child_profile_type {
  STANDARD
  SPECIAL_NEEDS
}

enum gender {
  MALE
  FEMALE
  OTHER
}

enum WhatsAppConversationStatus {
  ACTIVE
  COMPLETED
}

enum WhatsAppConversationStep {
  WELCOME
  COLLECT_NAME
  COLLECT_PHONE
  COLLECT_EMAIL
  COLLECT_CATEGORY
  COLLECT_ENQUIRY
  COMPLETED
}

enum WhatsAppEnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum report_input_type {
  TEXT
  RATING
  YES_NO
  MULTI_CHOICE
}

enum report_status {
  PENDING
  SUBMITTED
  OVERDUE
}

enum attendance_event_type {
  /// Geo-verified arrival within the on-time grace window.
  CHECK_IN
  /// Geo-verified arrival past the grace window.
  LATE_CHECK_IN
  /// Session closed by the caregiver.
  CHECK_OUT
  /// Closed materially before the scheduled end.
  EARLY_CHECK_OUT
  /// Never closed by the caregiver — the system had to auto-close it.
  MISSED_CHECK_OUT
  /// Slot start plus the no-show window elapsed with no check-in.
  NO_SHOW
  /// Caregiver cancelled inside the short-notice window.
  LATE_CANCEL
  /// Caregiver cancelled with enough notice to re-staff.
  ADVANCE_CANCEL
  /// Left the care location's geofence for longer than the tolerance mid-session.
  GEOFENCE_BREACH
  /// Went offline or stopped reporting while a session was under way.
  OFFLINE_DURING_SESSION
}

enum attendance_day_status {
  /// Every scheduled session attended on time.
  PRESENT
  /// All sessions attended, at least one late.
  LATE
  /// Some sessions attended, some missed or cancelled.
  PARTIAL
  /// Sessions were scheduled and none were served.
  ABSENT
  /// Blocked off in advance via `availability_blocks`, or granted by an admin.
  LEAVE
  /// Nothing was rostered. Not counted either way.
  OFF
}

model recurring_service_requests {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  parent_id            String    @db.Uuid
  /// The caregiver serving this plan. Source of truth for staffing: sessions
  /// generated by the rolling cron inherit it, so a plan assigned once stays
  /// assigned as it extends. Null means the plan is still unstaffed.
  nanny_id             String?   @db.Uuid
  recurrence_type      String    @db.VarChar(50) // e.g., "weekly", "specific_dates"
  recurrence_pattern   Json // Stores { "days": ["Mon", "Wed"], "dates": [1, 15], etc. }
  start_time           DateTime  @db.Time(6)
  duration_hours       Decimal   @db.Decimal(4, 2)
  start_date           DateTime  @db.Date
  end_date             DateTime? @db.Date
  num_children         Int
  children_ages        Json?
  special_requirements String?
  location_lat         Decimal   @db.Decimal(10, 8)
  location_lng         Decimal   @db.Decimal(11, 8)
  status               String    @default("active") @db.VarChar(50)
  required_skills      String[]
  category             String?   @db.VarChar(50)
  plan_duration_months Int?      @default(1)
  plan_type            String?   @db.VarChar(50)
  sessions_per_month   Int?
  /// Days a week the schedule runs — mirrors `recurrence_pattern.days.length`,
  /// stored explicitly so pricing never has to re-parse the pattern JSON.
  days_per_week        Int?
  max_hourly_rate      Decimal?  @db.Decimal(10, 2)

  /// Why and when the plan was ended. Previously only written onto the individual
  /// `bookings` rows, so "when was this plan cancelled" could not be answered
  /// without joining sessions that eventually age out of relevance.
  cancellation_reason  String?
  cancelled_at         DateTime? @db.Timestamptz(6)
  /// Sessions the parent had paid for at the instant of cancellation, frozen.
  ///
  /// Entitlement is otherwise derived live from `payment_installments`, which is
  /// correct right up until cancellation and wrong immediately after: a later
  /// refund flips a captured installment and would retroactively shrink a number
  /// the parent was already promised. The retained sessions themselves need no
  /// separate record — the surviving non-CANCELLED bookings are that record.
  sessions_entitled_at_cancellation Int?

  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)

  users            users             @relation("recurring_requests_parent_idTousers", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nanny            users?            @relation("recurring_requests_nanny_idTousers", fields: [nanny_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  bookings         bookings[]
  invoices         invoices[]
  plan_settlements plan_settlements?

  @@index([nanny_id])
}
