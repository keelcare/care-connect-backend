# Application Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5433/database_name
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Field-level encryption for sensitive PII (previous_salary, and identity_documents
# once encryption is wired up there — see EncryptionService). 32 bytes / 64 hex chars,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Google Maps API (for location features)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Gemini AI API (for AI matching recommendations)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary — not currently read by any service (Supabase Storage is used for
# uploads instead). Left here in case Cloudinary is reintroduced.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Supabase (database hosting + storage)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# DIRECT_URL is Prisma's session-mode connection, required for migrations
DIRECT_URL=postgresql://username:password@localhost:5433/database_name

# Razorpay (for payments) - REQUIRED in production
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# RazorpayX (caregiver payouts — money going OUT)
#
# RazorpayX is business banking and is activated separately from Payments, with its
# own KYC. Until it is, leave RAZORPAYX_ENABLED false: releasing a payout then
# records a manual settlement exactly as it did before this feature existed, and no
# gateway call is made.
#
# Keys: often the SAME pair as RAZORPAY_KEY_ID/_SECRET above, since one merchant
# account can cover both products — set these two only when they differ.
# RAZORPAYX_KEY_ID=your_razorpayx_key_id
# RAZORPAYX_KEY_SECRET=your_razorpayx_key_secret
#
# The RazorpayX *business account* number, from Dashboard -> Account Details. It is
# a virtual account (e.g. 2323230099089860), NOT your current account number, and it
# differs between test and live mode. Every payout request carries it.
RAZORPAYX_ACCOUNT_NUMBER=your_razorpayx_account_number
#
# Chosen by you when adding the webhook in Dashboard -> Settings -> Webhooks. Point
# it at POST /v1/payments/payout-webhook and subscribe to payout.processed,
# payout.reversed, payout.failed, payout.updated, payout.queued and payout.rejected.
RAZORPAYX_WEBHOOK_SECRET=your_razorpayx_webhook_secret
#
# The kill switch. Credentials alone do not make payouts live, because the payments
# keys are inherited as a fallback and are present in every environment — without a
# separate flag, a staging box with a copied .env would pay real caregivers.
RAZORPAYX_ENABLED=false
#
# IMPS (default) settles in minutes. NEFT/RTGS settle in banking-hour batches. UPI
# only works against a VPA fund account.
RAZORPAYX_PAYOUT_MODE=IMPS
RAZORPAYX_PAYOUT_PURPOSE=payout

# Mail Configuration (for nodemailer) — read as MAIL_*, not EMAIL_*
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your_email@example.com
MAIL_PASS=your_email_password
MAIL_FROM=Keel Care <your_email@example.com>

# Sentry Configuration
SENTRY_DSN=https://your_sentry_dsn_here

# Twilio Configuration (for SMS notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=your_twilio_from_number_here
# All three must be set for real SMS to send. If SID or token is missing the
# service logs a warning at boot and every sendSms() call is only simulated.

# WhatsApp Cloud API (enquiry bot + outbound messaging)
# All of these come from the Meta app dashboard. If PHONE_NUMBER_ID or
# ACCESS_TOKEN is missing the service logs a warning at boot and outbound
# messages are skipped instead of posting to an invalid URL.
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
# Graph API version used for the messages endpoint (defaults to v19.0)
WHATSAPP_API_VERSION=v19.0
# Token you choose; Meta echoes it back on webhook subscription verification
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here
# App secret used to validate the X-Hub-Signature-256 on inbound webhooks
WHATSAPP_APP_SECRET=your_whatsapp_app_secret_here

# Support inbox used for DPDP erasure notices and support ticket mail
SUPPORT_EMAIL=support@keelcare.in

# GST
# When enabled, GST_PERCENT is added on top of the subtotal and the customer is
# charged the tax-inclusive amount. Flipping this changes what customers pay.
# Each price_snapshot records the rate applied at charge time, so past charges
# are unaffected by a later flip.
GST_ENABLED=false
GST_PERCENT=18

# Caregiver payout commission is NOT configured here — it lives in the
# `system_settings.platform_commission_percent` row so admins can change it from
# the dashboard and both the caregiver app and revenue ledger move together.

# Universal / App Links (keelcare.in)
# Served at /.well-known/* for iOS/Android domain verification once keelcare.in
# points at this backend. Leave unset to serve 404 (links stay disabled).
# APPLE_TEAM_ID=AB12CD34EF
# ANDROID_CERT_SHA256=AA:BB:CC:...  (from `eas credentials`; comma-separate multiple)

# WebRTC calling (in-app parent <-> nanny calls)
# TURN relay credentials from metered.ca (free tier). Unset = STUN-only
# (calls on strict carrier NATs may fail to connect).
METERED_DOMAIN=yourapp.metered.live
METERED_API_KEY=your_metered_api_key_here

# Direct APNs push (iOS registers raw APNs tokens firebase-admin can't send to).
# .p8 auth key from the Apple Developer portal.
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apple_team_id
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_BUNDLE_ID=com.keel.careconnect
# Set to false to target the APNs sandbox (development builds)
APNS_PRODUCTION=true
